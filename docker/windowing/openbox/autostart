#!/bin/bash
# /defaults/autostart - openbox autostart for the webtop-kasmvnc image.
#
# The base image's init-kasmvnc-config copies /defaults/autostart to
# $HOME/.config/openbox/autostart on every start (its guard tests -d on a file,
# which is always false), so this file - not the copy - is the live source and
# shipping it in the image is enough; no volume seeding is involved.
#
# Two rules for an autostart script under openbox:
#   * it must not block: openbox-session waits on it, so anything long-running
#     goes to the background (no exec, no foreground loop);
#   * DISPLAY must be sanitised. The base writes DISPLAY with a trailing newline
#     and with-contenv injects it verbatim, so Xlib parses display number "1\\n"
#     and refuses the display. The previous webtop line lost its tint2 panel to
#     exactly this (svc crashed-loop while manual runs worked).
set -u

DISPLAY=$(printf '%s' "${DISPLAY:-:1}" | tr -d '\r\n')
export DISPLAY

# Solid dark background: no wallpaper file ships in the image (a 1600x900 JPEG
# costs more layer than it buys - the Kasm canvas is fully covered by app
# windows, and the desktop surface is not part of the product).
xsetroot -solid '#1c1712' 2>/dev/null || true

# Taskbar. -c points at the image copy so tint2 never writes its own default
# config on first run. rc.xml ships at /etc/xdg/openbox/rc.xml (Dockerfile COPY;
# a317 init-kasmvnc-config injects no rc of its own), so openbox reads the
# system copy and this file does not touch $HOME/.config/openbox.
CFG=/opt/wtk/windowing/tint2/tint2rc
if [ -r "$CFG" ]; then
  # The panel is the recovery affordance for minimised windows, so if it dies
  # the session is degraded: restart it on exit, bounded so a permanent failure
  # (missing X auth, bad config) cannot spin the CPU.
  (
    for _ in 1 2 3 4 5; do
      tint2 -c "$CFG" && break
      sleep 5
    done
  ) >/dev/null 2>&1 &
else
  echo "autostart: WARN: no tint2 config at $CFG; panel skipped" >&2
fi

# Desktop icons: pcmanfm runs as a DESKTOP MANAGER ONLY (root 2026-11-13: the
# user wants double-clickable icons). Openbox stays the only window manager -
# `pcmanfm --desktop` draws the desktop layer and icon grid, it never reparents
# app windows. This product ships exactly ONE MANAGED icon: Chrome, in the image
# at /defaults/desktop/Chrome.desktop. It is re-seeded on EVERY start with a
# force copy of that one name, then chmod 0755 (carried over from the 2-file
# 0.1.2 ruling; the single-icon product narrows the managed set to Chrome).
# cp -n was rejected: containers already seeded with a 0644 icon would never
# pick up the shipped fix, so the upgrade would not take effect. Only this name
# is managed - a file the user adds to ~/Desktop is untouched, and a deletion
# is restored on the next start by design (managed affordance, not user
# content).
# 0755 (not 0644): libfm 1.3.2 fm_file_info_is_executable_type accepts an
# application/x-desktop with only a read bit, but the launch needs the file to
# survive libfm's own executable check under quick_exec, and an exec bit is the
# unambiguous contract for a launchable launcher.
install -d -m 700 "$HOME/Desktop"
if [ -d /defaults/desktop ]; then
  for f in Chrome; do
    cp -f "/defaults/desktop/$f.desktop" "$HOME/Desktop/$f.desktop" 2>/dev/null || true
  done
  chmod 0755 "$HOME/Desktop/Chrome.desktop" 2>/dev/null || true
fi
# Seed pcmanfm desktop config once; keys read from lxde/pcmanfm 1.3.2 sources
# (desktop.c config keys): solid colour, no trash/documents/mounts.
PCFG="${XDG_CONFIG_HOME:-$HOME/.config}/pcmanfm/default/pcmanfm.conf"
if [ ! -e "$PCFG" ]; then
  install -d -m 700 "$(dirname "$PCFG")"
  printf '%s\n' '[config]' 'single_click=0' '[desktop]' 'wallpaper_mode=color' \
    'desktop_bg=#1c1712' 'show_trash=false' 'show_documents=false' 'show_mounts=false' \
    > "$PCFG"
fi
install -d -m 700 "$HOME/.local/state"
if command -v pcmanfm >/dev/null 2>&1; then
  (
    for _ in 1 2 3 4 5; do
      pcmanfm --desktop && break
      sleep 5
    done
  ) >> "$HOME/.local/state/wtk-pcmanfm.log" 2>&1 &
else
  echo "autostart: WARN: pcmanfm not installed; desktop icons skipped" >&2
fi
exit 0

